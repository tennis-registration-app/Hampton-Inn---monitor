<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cswilliams.hilton-monitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>__VENV_PY__</string>
    <string>__SCRIPT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NTFY_TOPIC</key>
    <string>__NTFY_TOPIC__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <!-- Every 4 hours (14400 seconds) -->
  <key>StartInterval</key>
  <integer>14400</integer>

  <!-- Run once at load so first check happens immediately -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__WORKDIR__/logs/monitor.out.log</string>

  <key>StandardErrorPath</key>
  <string>__WORKDIR__/logs/monitor.err.log</string>

  <!-- ProcessType deliberately omitted.
       Earlier we had ProcessType=Background, which causes macOS to
       throttle and defer the job aggressively (missed intervals during
       sleep were not catching up on wake). With ProcessType omitted, the
       job runs at standard priority and fires immediately on wake if an
       interval was missed. We still keep it light via LowPriorityIO. -->
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
